[{"title": "\u042e\u0436\u043d\u0430\u044f \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430", "text": "\u0422\u043e\u0432\u0430\u0440\u0438\u0449 \u0421\u0442\u0430\u043b\u0438\u043d, \u0432\u0430\u043c \u043d\u0435 \u043a\u0430\u0436\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u0423\u043a\u0440\u0430\u0438\u043d\u0446\u044b \u0435\u0434\u044f\u0442 \u0447\u0435\u0440\u0435\u0441\u0447\u0443\u0440 \u043c\u043d\u043e\u0433\u043e?", "Yes": {"paranoia": -10, "influense": -15}, "No": {"paranoia": 20, "influense": 5}}]